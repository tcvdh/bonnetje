# Copy to .env:  cp .env.example .env
# One NAME=value per line, no spaces around "=". Quote values that contain spaces.

# Required (unless you only use households made with `python3 server.py tenant add`, see server/README.md).
# The password the app sends. Anything works; a long random one is safer. Make one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# run.sh generates one for you if there is no .env yet.
RECEIPT_APP_KEY=

# Where the (built-in) household's housemates pay: the app builds its payment QR code from these.
# The IBAN is checked when the server starts.
RECEIPT_IBAN=NL00BANK0123456789
RECEIPT_NAME="Name on the account"
# Optional: your bunq.me handle. The payment screen then also offers a shareable bunq.me link with amount and description.
# RECEIPT_BUNQ=yourhandle

# Receipt scanning (photos of any store). Without a key, scanning is off.
# RECEIPT_GEMINI_KEY=
# RECEIPT_GEMINI_MODEL=gemini-3.8-flash

# Albert Heijn integration. OFF by default. Only for your own, self-hosted server: it uses AH's
# unofficial API, so never switch it on for a server that other people use. See server/README.md.
# RECEIPT_USE_AH_API=true

# Admin dashboard: a LAN web page to add and change households, see their usage and change the limits.
# Off unless BOTH are set. It only accepts connections from private IPs, localhost and .local hostnames.
# RECEIPT_ADMIN_PORT=3001
# RECEIPT_ADMIN_KEY=                # its password, separate from RECEIPT_APP_KEY

# Limits per household (all can also be changed live in the dashboard, which wins over these; 0 = unlimited).
# Only really needed for a server that other people use (more households, see server/README.md):
# RECEIPT_REQUESTS_PER_MINUTE=120   # a busy household opening the app needs about 30 in a burst
# RECEIPT_SCANS_PER_MINUTE=5
# RECEIPT_SCANS_PER_WEEK=25         # Gemini scans per week per household (default 25; 0 = unlimited)
# RECEIPT_PHOTO_DAYS=90             # delete photos of kept receipts after this many days (0 = keep)

# For a reverse proxy and a public server:
# RECEIPT_TRUSTED_PROXY=172.18.0.1  # your reverse proxy: only then X-Forwarded-For is believed
# RECEIPT_CORS_ORIGIN=              # empty = no CORS headers (default *)

# Optional.
# RECEIPT_PORT=3000
# RECEIPT_HOST=0.0.0.0          # 127.0.0.1 behind a reverse proxy
# RECEIPT_DATA_DIR=./state      # the Docker image fixes this to /data; leave it out there
